<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PharmacyApp.Desktop.ViewModels.Reports"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="PharmacyApp.Desktop.Views.Reports.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <!-- ═══════════════════════════════════════ HEADER ═══════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Financial &amp; Compliance Reports" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="Valuation of stock on hand, projected margins, and tamper-resistant audit logs."
                           FontSize="13" Foreground="#8E8EA0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding ExportCurrentTabCsvCommand}"
                        Background="#1E3A2F"
                        Foreground="#34D399"
                        FontWeight="SemiBold"
                        Padding="14,8"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📥" FontSize="12" />
                        <TextBlock Text="Export CSV" FontSize="13" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding LoadReportsCommand}"
                        Background="#262645"
                        Foreground="#E0E0FF"
                        Padding="14,8"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🔄" FontSize="12" />
                        <TextBlock Text="Recalculate" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════ KPI SUMMARY ══════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,20">
            <Border Grid.Column="0" Background="#16162A" BorderBrush="#252542" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="Total Inventory Units" FontSize="12" Foreground="#8888AA" />
                    <TextBlock Text="{Binding ValuationReport.TotalUnitsOnHand}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="{Binding ValuationReport.TotalDistinctMedicines, StringFormat='Across {0} products'}" FontSize="11" Foreground="#60A5FA" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#16162A" BorderBrush="#252542" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="Total Cost Basis" FontSize="12" Foreground="#8888AA" />
                    <TextBlock Text="{Binding ValuationReport.TotalCostValueNpr, StringFormat='NPR {0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Purchased inventory value" FontSize="11" Foreground="#AAA" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#16162A" BorderBrush="#252542" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="Projected Retail Value" FontSize="12" Foreground="#8888AA" />
                    <TextBlock Text="{Binding ValuationReport.TotalRetailValueNpr, StringFormat='NPR {0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#10B981" />
                    <TextBlock Text="Gross realizable sales" FontSize="11" Foreground="#34D399" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#16162A" BorderBrush="#252542" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Projected Gross Margin" FontSize="12" Foreground="#8888AA" />
                    <TextBlock Text="{Binding ValuationReport.OverallMarginPercentage, StringFormat='{}{0:N1}%'}" FontSize="24" FontWeight="Bold" Foreground="#A78BFA" />
                    <TextBlock Text="{Binding ValuationReport.TotalPotentialProfitNpr, StringFormat='NPR {0:N2} profit'}" FontSize="11" Foreground="#C4B5FD" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════ TABS & DATA ══════════════════════════════════ -->
        <Border Grid.Row="2" Background="#16162A" CornerRadius="12" BorderBrush="#252542" BorderThickness="1" Padding="16">
            <Grid RowDefinitions="Auto,*">
                <!-- Tab Switching Bar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                    <Button Command="{Binding SelectValuationTabCommand}"
                            Background="{Binding ValuationTabBackground}"
                            Foreground="{Binding ValuationTabForeground}"
                            Padding="16,8"
                            CornerRadius="8"
                            FontSize="13"
                            FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📦" FontSize="13" />
                            <TextBlock Text="Inventory Valuation by Product" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectAuditTabCommand}"
                            Background="{Binding AuditTabBackground}"
                            Foreground="{Binding AuditTabForeground}"
                            Padding="16,8"
                            CornerRadius="8"
                            FontSize="13"
                            FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📜" FontSize="13" />
                            <TextBlock Text="Full Audit Ledger" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 1. Inventory Valuation Tab -->
                <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding IsValuationTabActive}">
                    <Border Grid.Row="0" Background="#1C1C36" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="2*,1.5*,*,*,*,*,*,*">
                            <TextBlock Grid.Column="0" Text="Medicine" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="Generic Name" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="Category" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="Units On Hand" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="4" Text="Reorder Lvl" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="5" Text="Cost (NPR)" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="6" Text="Retail (NPR)" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="7" Text="Margin" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ValuationReport.Items}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,1.5*,*,*,*,*,*,*" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="{Binding MedicineName}" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding GenericName}" Foreground="#B0B0D0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="#8090C0" />
                                    <TextBlock Grid.Column="3" Text="{Binding TotalUnitsOnHand}" FontWeight="Bold" Foreground="#60A5FA" />
                                    <TextBlock Grid.Column="4" Text="{Binding ReorderLevel}" Foreground="#C0C0E0" />
                                    <TextBlock Grid.Column="5" Text="{Binding TotalCostValueNpr, StringFormat='{}{0:N2}'}" Foreground="#A0A0C0" />
                                    <TextBlock Grid.Column="6" Text="{Binding TotalRetailValueNpr, StringFormat='{}{0:N2}'}" Foreground="#34D399" />
                                    <TextBlock Grid.Column="7" Text="{Binding MarginPercentage, StringFormat='{}{0:N1}%'}" FontWeight="SemiBold" Foreground="#A78BFA" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 2. Full Audit Ledger Tab -->
                <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding IsAuditTabActive}">
                    <Border Grid.Row="0" Background="#1C1C36" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="1.5*,2*,*,*,*,2*,1.5*">
                            <TextBlock Grid.Column="0" Text="Movement Type" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="Medicine" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="Batch Code" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="Qty Delta" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="4" Text="New Qty" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="5" Text="Reason / Audit Note" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                            <TextBlock Grid.Column="6" Text="Date &amp; Time" FontWeight="SemiBold" Foreground="#A0A0C0" FontSize="12" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AuditTrail}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="1.5*,2*,*,*,*,2*,1.5*" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="{Binding AdjustmentTypeName}" Foreground="#C0C0E0" />
                                    <TextBlock Grid.Column="1" Text="{Binding MedicineName}" Foreground="#FFFFFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding BatchCode}" Foreground="#A0A0C0" FontFamily="Consolas,Monospace" />
                                    <TextBlock Grid.Column="3" Text="{Binding QuantityDelta}" FontWeight="Bold" Foreground="#60A5FA" />
                                    <TextBlock Grid.Column="4" Text="{Binding NewQuantity}" Foreground="#E0E0FF" />
                                    <TextBlock Grid.Column="5" Text="{Binding Reason}" Foreground="#8E8EA0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{Binding TimestampUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#707090" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ STATUS ═══════════════════════════════════════ -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="12" Foreground="#7A7A9E" Margin="0,12,0,0" />

    </Grid>
</UserControl>
